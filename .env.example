# PropIQ Analytics — copy to .env and fill in. NEVER commit .env.
# Scope: NBA only. RESEARCH_ONLY — no wagering, no betting automation.

# ---------------------------------------------------------------------------
# DATABASE (required) — PostgreSQL / Supabase
# ---------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string.
# Use the CONNECTION POOLER url (port 6543) for this pipeline; use the
# direct connection (port 5432) for migrations.
# sslmode=require is appended automatically for remote hosts.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Alternative to DATABASE_URL — individual parts (used only if DATABASE_URL is unset):
# PGHOST=
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=postgres

# ---------------------------------------------------------------------------
# MASTER GUIDELINE (player props)
# ---------------------------------------------------------------------------
# Path to your player-props master guideline file. If unset, the pipeline
# defaults to config/master_guideline_props.yaml and logs a warning when
# the file is absent.
PROPIQ_MASTER_GUIDELINE=config/master_guideline_props.yaml

# ---------------------------------------------------------------------------
# DATA SOURCES
# ---------------------------------------------------------------------------
# BigDataBall licensed export (manual download — never scraped, never committed).
BIGDATABALL_XLSX=data/external/bigdataball/2025-2026_NBA_Box_Score_Team-Stats_1.xlsx

# PropLine odds API — posted NBA prop lines with capture timestamps.
# This is what makes CLV, de-vigged fair probabilities and honest
# calibration possible; without it RESEARCH_LINE (a trailing 10-game
# average) is the only "line" and the evaluation target is self-referential.
# NEVER commit a real key. Rotate any key that has ever been pasted into a
# chat, a screenshot, or a URL.
PROPLINE_API_KEY=

# Optional: other timestamped odds providers (research / historical CLV only).
# ODDSPAPI_API_KEY=

# Optional: free-tier enrichment (injuries/schedule). Odds endpoints stay blocked.
# BBS_API_KEY=

# ---------------------------------------------------------------------------
# NOTIFICATIONS — Discord
# ---------------------------------------------------------------------------
# Run summaries and data-quality warnings post here. Research notifications
# only: never a bet instruction, a "lock", or a wagering prompt.
DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------------
# User-facing / slate dates: America/Los_Angeles only. Storage remains UTC.
TZ_DISPLAY=America/Los_Angeles
LOG_LEVEL=INFO
