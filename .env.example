# PropIQ Analytics — copy to .env and fill in. NEVER commit .env.
# Scope: NBA only. RESEARCH_ONLY — no wagering, no betting automation.

# ---------------------------------------------------------------------------
# DATABASE (required) — PostgreSQL / Supabase
# ---------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string.
# Use the CONNECTION POOLER url (port 6543) for this pipeline; use the
# direct connection (port 5432) for migrations.
# sslmode=require is appended automatically for remote hosts.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Alternative to DATABASE_URL — individual parts (used only if DATABASE_URL is unset):
# PGHOST=
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=postgres

# ---------------------------------------------------------------------------
# MASTER GUIDELINE (player props)
# ---------------------------------------------------------------------------
# Path to your player-props master guideline file. If unset, the pipeline
# defaults to config/master_guideline_props.yaml and logs a warning when
# the file is absent.
PROPIQ_MASTER_GUIDELINE=config/master_guideline_props.yaml

# ---------------------------------------------------------------------------
# WHERE THE PARLAY LEDGER LIVES
# ---------------------------------------------------------------------------
# csv (default) keeps it in data/external/parlay_log/*.csv, which is convenient
# locally and DESTROYED BY THE NEXT REDEPLOY on a container: `data/**` is
# gitignored and a container filesystem is ephemeral. The ledger holds each
# ticket's at-bet-time probability and EV, which is the only record of what was
# predicted before a game and the one thing that cannot be recomputed after it.
#
# Set this to `postgres` on any deployed run. A typo raises rather than falling
# back, because falling back would look like it worked and lose the ledger.
# PROPIQ_PARLAY_LEDGER=postgres

# ---------------------------------------------------------------------------
# DATA SOURCES
# ---------------------------------------------------------------------------
# BigDataBall licensed export (manual download — never scraped, never committed).
BIGDATABALL_XLSX=data/external/bigdataball/2025-2026_NBA_Box_Score_Team-Stats_1.xlsx

# PropLine odds API — posted NBA prop lines with capture timestamps.
# This is what makes CLV, de-vigged fair probabilities and honest
# calibration possible; without it RESEARCH_LINE (a trailing 10-game
# average) is the only "line" and the evaluation target is self-referential.
# NEVER commit a real key. Rotate any key that has ever been pasted into a
# chat, a screenshot, or a URL.
PROPLINE_API_KEY=


# Optional: free-tier enrichment (injuries/schedule). Odds endpoints stay blocked.
# BBS_API_KEY=

# ---------------------------------------------------------------------------
# NOTIFICATIONS — Discord
# ---------------------------------------------------------------------------
# Decision boards, parlay tickets and abstention notices post here. Research
# notifications only: never a bet instruction, a "lock", or a wagering prompt.
#
# THE URL IS A CREDENTIAL. Anyone holding it can post to that channel as you.
# Never commit it; rotate it if it has ever been pasted into a chat, a
# screenshot or a URL. src/notify/discord.py redacts it from every error and
# log line, and refuses to put it inside a message body.
#
# Channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
#
# No DISCORD_BOT_TOKEN is needed: dispatch uses webhooks, which require no bot,
# no gateway connection and no privileged intents. An unused credential slot is
# a liability, so one is not declared here.
#
# Sending is opt-in per invocation: notify-discord is a dry run that prints the
# payload unless --send is passed.

# ---------------------------------------------------------------------------
# RUNTIME
# ---------------------------------------------------------------------------
# User-facing / slate dates: America/Los_Angeles only. Storage remains UTC.
TZ_DISPLAY=America/Los_Angeles
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# THE DEPLOYED WORKER (scheduler_worker.py)
# ---------------------------------------------------------------------------
# All optional — every one has a default in the code. They are listed because
# an undocumented variable is one nobody sets on purpose, and two of them
# decide whether a deployed run keeps anything.

# WHERE DURABLE STATE GOES. On a container this MUST be on the mounted volume
# (the image sets /app/data/calibration.json). The settlement job writes this
# at 03:30 PT and the slate job reads it at 09:00 PT; on an ephemeral path a
# redeploy between the two leaves the publication gate with no evidence, so
# every card is withheld for a reason that is not the real one.
# PROPIQ_CALIBRATION_REPORT=/app/data/calibration.json

# Where the recommendation board CSV is written and then read by dispatch.
# Regenerated every slate, so it does not need to be durable.
# PROPIQ_BOARD_CSV=outputs/decision_board.csv

# DISPATCH. Defaults to ON when DISCORD_WEBHOOK_URL is set, OFF otherwise —
# a worker with no webhook should not spend a slate trying to post. Set this
# explicitly to override either way.
# PROPIQ_DISPATCH=true
# Default ON: the house rule is that a refusal is posted too, because silence
# reads as "nothing good today". Set false to stay quiet on a withheld board.
# PROPIQ_DISPATCH_ABSTENTIONS=false

# SCHEDULE, in Pacific. Slate before the earliest tip, settlement after the
# latest finish. An unusable value falls back to the default rather than
# refusing to start.
# PROPIQ_SLATE_HOUR_PT=9
# PROPIQ_SLATE_MINUTE_PT=0
# PROPIQ_SETTLE_HOUR_PT=3
# PROPIQ_SETTLE_MINUTE_PT=30

# Run one slate immediately at boot. OFF by default: left on, a redeploy loop
# re-runs the slate each time. Set it for a single first run.
# PROPIQ_RUN_ON_START=true

# BOARD BUILD PARAMETERS, matching the decision-board CLI defaults.
# PROPIQ_BOARD_MARKETS=PTS,REB,AST
# PROPIQ_BOARD_TRAIN_END=2025-01-15
# PROPIQ_BOARD_VALIDATION_END=2025-02-15
# PROPIQ_MIN_EV=0.0

# Caps OMP / OpenBLAS / MKL / NumExpr / vecLib. The image sets 2. The numeric
# libraries otherwise see the HOST's core count, not this container's share, so
# the default is contention rather than parallelism — match your plan's CPU.
# PROPIQ_MAX_THREADS=2

# ---------------------------------------------------------------------------
# STORAGE BACKENDS
# ---------------------------------------------------------------------------
# Where the parlay ledger lives. The image sets `postgres`; see the block above
# on the parlay ledger for why csv is destroyed by a redeploy.
# PROPIQ_PARLAY_LEDGER=postgres

# Local cache for the official pregame inactive lists.
# PROPIQ_INACTIVE_CACHE_DIR=data/external/inactive_players

# ---------------------------------------------------------------------------
# ESPN (public, no credential)
# ---------------------------------------------------------------------------
# Override the ESPN site API base. For tests and fixtures only — there is no
# key, and the default is correct in production.
# PROPIQ_ESPN_SITE_BASE=https://site.api.espn.com/apis/site/v2/sports/basketball/nba
